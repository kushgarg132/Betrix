# ─── Scalars ────────────────────────────────────────────
scalar DateTime
scalar JSON

# ─── Enums ──────────────────────────────────────────────

enum Suit {
  HEARTS
  DIAMONDS
  CLUBS
  SPADES
}

enum Rank {
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
  JACK
  QUEEN
  KING
  ACE
}

enum GameStatus {
  WAITING
  STARTING
  PRE_FLOP_BETTING
  FLOP_BETTING
  TURN_BETTING
  RIVER_BETTING
  SHOWDOWN
  FINISHED
}

"""A betting action on the caller's own turn. Leaving, sitting out and sitting in are not turn
actions -- see the leaveGame/sitOut/sitIn mutations."""
enum ActionType {
  BET
  CHECK
  FOLD
}

enum HandRank {
  HIGH_CARD
  ONE_PAIR
  TWO_PAIR
  THREE_OF_A_KIND
  STRAIGHT
  FLUSH
  FULL_HOUSE
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
}

enum GameUpdateType {
  PLAYER_JOINED
  GAME_STARTED
  CARDS_DEALT
  ROUND_STARTED
  COMMUNITY_CARDS
  PLAYER_ACTION
  GAME_ENDED
  CHAT_MESSAGE
}

enum BotDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RoundType {
  PRE_FLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
}

# ─── Types ──────────────────────────────────────────────

type Card {
  suit: Suit!
  rank: Rank!
}

type HandResult {
  rank: HandRank!
  highCards: [Card!]!
}

type Player {
  id: ID
  name: String!
  username: String!
  hand: [Card!]!
  chips: Int!
  isActive: Boolean!
  currentBet: Int!
  hasFolded: Boolean!
  lastWinAmount: Int!
  isSittingOut: Boolean!
  bestHand: HandResult
  timeBankMs: Float!
  isAllIn: Boolean!
  isBot: Boolean!
  botDifficulty: BotDifficulty
}

type Pot {
  amount: Int!
  eligiblePlayerIds: [String!]!
}

type BettingRound {
  bets: JSON
  roundType: RoundType
}

type Game {
  id: ID!
  players: [Player!]!
  communityCards: [Card!]!
  pot: Int!
  pots: [Pot!]!
  status: GameStatus!
  currentBettingRound: BettingRound
  dealerPosition: Int!
  currentPlayerIndex: Int!
  createdAt: DateTime
  updatedAt: DateTime
  smallBlindAmount: Int!
  bigBlindAmount: Int!
  currentBet: Int!
  smallBlindUserId: String
  bigBlindUserId: String
  lastActions: JSON
  playerActionTimeoutSeconds: Int!
  currentPlayerActionDeadline: DateTime
  maxPlayers: Int!
  playerCount: Int!
  isGameFull: Boolean!
}

"""Lightweight game summary for the lobby — avoids sending full player data."""
type GameSummary {
  id: ID!
  status: GameStatus!
  playerCount: Int!
  maxPlayers: Int!
  smallBlindAmount: Int!
  bigBlindAmount: Int!
  pot: Int!
  createdAt: DateTime
  """True if the caller is already seated at this table. Never reveals who else is seated."""
  isYourGame: Boolean!
}

type User {
  id: ID!
  name: String!
  username: String!
  email: String
  avatarUrl: String
  balance: Int! @deprecated(reason: "Play money: chips belong to a table and every player sits down with the same buy-in. Will be removed.")
  roles: [String!]!
  registrationDate: DateTime
  handsPlayed: Int!
  handsWon: Int!
  winRate: Float!
  netProfit: Int!
}

type AuthPayload {
  token: String!
  type: String!
  user: User
}

type GameEvent {
  id: ID!
  gameId: String!
  timestamp: DateTime!
  eventType: String!
  eventData: JSON
}

type GameUpdate {
  gameId: String!
  type: GameUpdateType!
  payload: JSON
  timestamp: DateTime!
}

type ChatMessage {
  senderId: String!
  senderName: String!
  message: String!
  timestamp: DateTime!
}

# ─── Inputs ─────────────────────────────────────────────

input LoginInput {
  username: String!
  password: String!
}

input RegisterInput {
  name: String!
  username: String!
  password: String!
  email: String!
}

input BlindInput {
  smallBlindAmount: Int!
  bigBlindAmount: Int!
}

input PlayerActionInput {
  actionType: ActionType!
  amount: Int
}

# ─── Queries ────────────────────────────────────────────

type Query {
  """Get the currently authenticated user."""
  me: User

  """List all games (lobby view — lightweight)."""
  games: [GameSummary!]!

  """Get a single game (spectator view — hands hidden)."""
  game(id: ID!): Game

  """Get the game from the caller's own seat's perspective (their own hand visible)."""
  gameForPlayer(gameId: ID!): Game

  """Get event history for a game."""
  gameEvents(gameId: ID!): [GameEvent!]!

  """Get events filtered by type."""
  gameEventsByType(gameId: ID!, eventType: String!): [GameEvent!]!

  """Replay a full game from event history."""
  replayGame(gameId: ID!): Game

  """Replay a game up to a specific event."""
  replayGameUntilEvent(gameId: ID!, eventId: ID!): Game
}

# ─── Mutations ──────────────────────────────────────────

type Mutation {
  """Authenticate with username/password. Returns JWT."""
  login(input: LoginInput!): AuthPayload!

  """Register a new user account."""
  register(input: RegisterInput!): User!

  """Create a guest session. Returns JWT."""
  guestLogin: AuthPayload!

  """Sign in with a Google ID token (from Google Identity Services). Returns JWT."""
  googleLogin(idToken: String!): AuthPayload!

  """Create a new poker game with specified blinds."""
  createGame(input: BlindInput!): Game!

  """Join an existing game. Returns the updated game state."""
  joinGame(gameId: ID!): Game!

  """Delete a game (admin only)."""
  deleteGame(gameId: ID!): Boolean!

  """Add balance to the current user's account."""
  addBalance(amount: Int!): User! @deprecated(reason: "Play money: there is no account balance. Will be removed.")

  """Perform a betting action (bet, check, fold) on the caller's own turn."""
  playerAction(gameId: ID!, input: PlayerActionInput!): Boolean!

  """Leave a game. If a hand is in progress, folds first and the seat clears once the hand ends."""
  leaveGame(gameId: ID!): Boolean!

  """Sit out: skip future hands without leaving the table."""
  sitOut(gameId: ID!): Boolean!

  """Sit back in after sitting out."""
  sitIn(gameId: ID!): Boolean!

  """Start a new hand in a game."""
  startHand(gameId: ID!): Boolean!

  """Send a chat message to a game, as the caller's own seat."""
  sendChat(gameId: ID!, message: String!): ChatMessage!

  """Add an AI bot player to a game."""
  addBot(gameId: ID!, difficulty: BotDifficulty): Player!

  """Remove a bot player from a game."""
  removeBot(gameId: ID!, botPlayerId: ID!): Boolean!
}

# ─── Subscriptions ──────────────────────────────────────

type Subscription {
  """Subscribe to all updates for a game (broadcast to all players/spectators)."""
  gameUpdated(gameId: ID!): GameUpdate!

  """Subscribe to the caller's own private updates (their own hand info) for a game."""
  playerUpdated(gameId: ID!): GameUpdate!
}
