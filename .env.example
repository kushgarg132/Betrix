# Copy to .env on the deploy host (never commit .env).
BACKEND_PORT=8083
SPRING_APPLICATION_NAME=betrix
SPRING_DATA_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/betrix
# Must be base64 and decode to 64+ bytes, or the app refuses to start: openssl rand -base64 64
APP_JWT_SECRET=replace-with-output-of-openssl-rand-base64-64
APP_JWT_EXPIRATION=3600000
GAME_ROUND_END_DELAY=5000
GAME_PLAYER_TIMEOUT_DELAY=30000
GAME_PLAYER_ACTION_TIMEOUT_SECONDS=30
GAME_IDLE_TIMEOUT_MINUTES=10
GAME_AUTO_START=true
ADMIN_USERNAME=admin
# Required (12+ chars) the first time the admin account is created; the app refuses to start otherwise
ADMIN_PASSWORD=change-me-to-12-plus-chars
ADMIN_EMAIL=admin@betrix.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_HARD=gemini-2.5-pro
# GEMINI_MAX_CALLS_PER_MINUTE=30

# Optional. Defaults are safe for production.
# Chips every player sits down with (play money, same for guests and registered users).
# GAME_BUY_IN=10000
# Comma-separated browser origins allowed to call the API (exact match, credentials allowed).
# APP_CORS_ALLOWED_ORIGINS=https://betrix-b3c24.web.app,https://betrix-b3c24.firebaseapp.com,http://localhost:3000,http://localhost:5173
# Login/register/guestLogin attempts per client IP per minute.
# APP_AUTH_RATE_LIMIT_PER_MINUTE=20
# Dev tooling, all off unless set to true (the `local` profile turns them on).
# GRAPHIQL_ENABLED=false
# GRAPHQL_INTROSPECTION_ENABLED=false
# SWAGGER_ENABLED=false
