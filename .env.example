# Copy to .env on the deploy host (never commit .env).
BACKEND_PORT=8083
SPRING_APPLICATION_NAME=betrix
SPRING_DATA_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/betrix
APP_JWT_SECRET=change-me-openssl-rand-base64-48
APP_JWT_EXPIRATION=3600000
GAME_ROUND_END_DELAY=5000
GAME_PLAYER_TIMEOUT_DELAY=30000
GAME_PLAYER_ACTION_TIMEOUT_SECONDS=30
GAME_IDLE_TIMEOUT_MINUTES=10
GAME_AUTO_START=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@betrix.com
GEMINI_API_KEY=
